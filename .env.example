# Endereço público do site (usado em sitemap, metadados e links canônicos)
NEXT_PUBLIC_SITE_URL=https://petapoio.com.br

# Supabase — Settings → API. Só a chave "anon" é usada na Onda 1:
# as tabelas aceitam apenas inserção pública (RLS), nunca leitura.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só para pré-visualização: "true" publica artigos ainda sem revisão clínica.
# Em produção, deixe vazio — artigo sem revisor não vai ao ar.
PUBLISH_UNREVIEWED=
