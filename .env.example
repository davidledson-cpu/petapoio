# Endereço público do site (usado em sitemap, metadados e links canônicos)
NEXT_PUBLIC_SITE_URL=https://petapoio.com.br

# Supabase — Settings → API. Só a chave "anon" é usada na Onda 1:
# as tabelas aceitam apenas inserção pública (RLS), nunca leitura.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só para pré-visualização: "true" publica artigos ainda sem revisão clínica.
# Em produção, deixe vazio — artigo sem revisor não vai ao ar.
PUBLISH_UNREVIEWED=

# Supabase — chave secreta, só no servidor (webhook de pagamento, tokens do split, arquivos privados)
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — Checkout Pro
# Token da conta da PetApoio (recebe a loja e a comissão das sessões)
MP_ACCESS_TOKEN=
# Aplicação marketplace (split): psicólogos conectam a própria conta por OAuth
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Assinatura das notificações (Suas integrações → Webhooks → chave secreta)
MP_WEBHOOK_SECRET=
# 32 bytes em base64 para criptografar os tokens dos psicólogos: openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=
